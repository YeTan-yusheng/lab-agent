# 数据库连接配置
DATABASE_URL=mysql+pymysql://用户名:密码@localhost:3306/lab_agent?charset=utf8mb4
TEST_DATABASE_URL=mysql+pymysql://用户名:密码@localhost:3306/lab_agent_test?charset=utf8mb4
#JWT配置
JWT_SECRET_KEY=yyOC8inNMKThHcbHZ64OsSVxbZgYL195NqSWhH1Oi7a
JWT_EXPIRE_HOURS=24
JWT_ALGORITHM="HS256"
#LLM配置
LLM_API_KEY=你的apikey
LLM_BASE_URL=https://maas.qianwenaiapi.com/compatible-mode/v1 # 阿里云百炼平台
LLM_MODEL=deepseek-r1
# 运行环境：development / test / production
APP_ENV=development
# 种子账号默认密码
SEED_DEFAULT_PASSWORD=123456
# 日志配置
LOG_LEVEL=INFO
LOG_FORMAT=text
LOG_COLOR=true
LOG_TO_FILE=true
LOG_DIR=logs
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
SLOW_REQUEST_MS=2000
# 邮件通知配置：console 本地演示，smtp 生产发送
EMAIL_BACKEND=console
EMAIL_FROM=lab-agent@lab.local
SMTP_HOST=SMTP 服务器地址
SMTP_PORT=587
SMTP_USERNAME=你的邮箱@example.com
SMTP_AUTH_CODE=邮箱授权码
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=120
EMAIL_WORKER_ENABLED=true
EMAIL_WORKER_INTERVAL_SECONDS=30
EMAIL_BATCH_SIZE=50
EMAIL_MAX_ATTEMPTS=5
EMAIL_RETRY_DELAYS=60,300,900,3600,21600
EMAIL_SENDING_TIMEOUT_SECONDS=600
